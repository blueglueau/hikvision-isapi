{
  "name": "hikvision-isapi/laravel11-compatibility",
  "description": "Isolated Laravel 11 compatibility fixture.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "11.57.*",
    "shaykhnazar/hikvision-isapi": "^1.6@dev"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0",
    "phpunit/phpunit": "^10.5|^11.0",
    "mockery/mockery": "^1.6",
    "laravel/pint": "^1.18",
    "larastan/larastan": "^3.0",
    "phpstan/phpstan-mockery": "^2.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../..",
      "options": {
        "symlink": true,
        "reference": "none",
        "versions": {
          "shaykhnazar/hikvision-isapi": "1.6.x-dev"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shaykhnazar\\HikvisionIsapi\\Tests\\": "../../../tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2.32"
    },
    "policy": {
      "advisories": {
        "ignore-id": {
          "PKSA-d5tc-s1qs-h781": {
            "on-block": true,
            "on-audit": false,
            "reason": "Isolated compatibility testing of end-of-life Laravel 11; retain audit reporting."
          },
          "PKSA-m5cs-t1y6-qpcs": {
            "on-block": true,
            "on-audit": false,
            "reason": "Isolated compatibility testing of end-of-life Laravel 11; retain audit reporting."
          },
          "PKSA-3r5d-mb8f-1qw9": {
            "on-block": true,
            "on-audit": false,
            "reason": "Isolated compatibility testing of end-of-life Laravel 11; retain audit reporting."
          },
          "PKSA-mdq4-51ck-6kdq": {
            "on-block": true,
            "on-audit": false,
            "reason": "Isolated compatibility testing of end-of-life Laravel 11; retain audit reporting."
          }
        }
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
